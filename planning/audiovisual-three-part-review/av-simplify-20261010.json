    "read_range": "完整E01共两场64块，与e01.md连读；样例引用S001 b001-b009及后续S001/S002语境"
  },
  "shot": {
    "status": "current_fact",
    "object_id": "av-e01-a01-s01",
    "revision_id": "982201d6e8e009c605b9abe4015de8511d856021abd006305b04eda7afa87325",
    "code": "ASH001",
    "title": "01 · A01 · 01 阿蘅翻过两页",
    "existing_purpose": "先摊本压石再唱；老汉持扁担在门边听，唱句结束才翻页",
    "duration_seconds": 14.0,
    "source_blocks": [
      {
        "id": "screenplay-04-lantern-home-s001-b001",
        "text": "河街的米铺开着门。里头有人量米，门外，阿蘅把歌本摊在倒扣的竹篮上，压一块河石。她是个清瘦的女孩，洗旧的青衣袖口挽得整齐，唱歌时脚下稳稳打着拍子。"
      },
      {
        "id": "screenplay-04-lantern-home-s001-b002",
        "text": "阿蘅（唱）：一道险滩水急，船头慢慢行——"
      },
      {
        "id": "screenplay-04-lantern-home-s001-b003",
        "text": "挑柴老汉把扁担竖在腿边，跟着点头。阿蘅翻过两页，调子忽然一转。"
      }
    ]
  },
  "proposed_narrative_intention": {
    "status": "proposed_creative_sample_not_adopted",
    "text": "先让观众认识一个靠唱歌谋生、熟悉街坊也能自如招呼听众的女孩：阿蘅不是等待别人照料的可怜孩子，唱歌是她正在认真做的日常工作。开场应有生活的轻快与亲近；老汉听得入神、预备接唱，使翻页跳段成为下一镜善意玩笑的起点。此时不提前渲染祭蛇危险。",
    "basis": "S001 b001-b009的劳作、跟唱与玩笑，S001 b017-b025的工钱与预付及E01原有意图共同支持；并非原文逐字意图声明。",
    "check": "连续读ASH001—003，能解释为什么应看见老汉参与和阿蘅的从容；与后续米报酬相接，不添加剧情或提前惊悚。"
  },
  "proposed_key_states": [
    {
      "status": "proposed_display_and_binding_of_existing_fact",
      "local_key": "opening-before-first-action",
      "name": "开唱前 · 摊本之前",
      "description": "阿蘅站在空竹篮旁，歌本尚在手中，河石搁在篮面；阿蘅在米铺门口，听客区与她在同一可辨空间。",
      "material_requirements": [

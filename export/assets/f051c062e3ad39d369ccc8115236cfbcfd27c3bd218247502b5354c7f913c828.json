  "purpose": "本轮新生成代表基础音色；待用户听审",
  "sources": [
    {
      "text": "这是今天的。",
      "source": {
        "object_id": "screenplay-04-lantern-home-e01",
        "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",

            {
              "to": "shot",
              "label": "镜头也是实体"
            }
          ]
        },
        {
          "id": "state",
          "title": "实体状态 · ST",
          "text": "只属于一个实体；确需独立准备，且至少拥有一项真实素材需求。",
          "version": "仅当前内容，不滚动存稿",
          "comments": "可评论，保存当时摘录"
        },
        {
          "id": "requirement",
          "title": "素材／素材需求 · M",
          "text": "唯一出处为实体（普通 EN 或镜头 ASH）或必要状态 ST。按独立交付职责保存一个素材分类，自动取得方法；拥有一份当前方案与零到多个真实候选。",
          "version": "仅当前内容，不滚动存稿",
          "comments": "可评论，保存当时摘录",
          "related": [
            {
              "to": "shot",
              "label": "也可归属镜头"
            }
          ]
        },

{
  "schema_version": 1,
  "episodes": [
    {
      "object_id": "screenplay-01-lantern-home-e01",
      "revision_id": "be410227b2b3931edc52ee717c2e3bcec1268c59cda0bdf209ff87567e35ed60",
      "summary": "阿蘅靠唱歌换米，接下许家的差事；赵执事邀她去庙里领唱。李寄想起先前被祭的女孩，为朋友担心。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e02",
      "revision_id": "d9d54a21a56cb4dffeb07566053bf484c330952e4c6ad15f0c10bdee31ee90f8",
      "summary": "李寄为了阻止阿蘅去庙里毁掉歌本，阿蘅失去差事并退回预付米。两人捞回残页，李寄道歉，信任却没有立刻复原。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e03",
      "revision_id": "61247f5ffe79dbb544fbe49e944ab34d5401d7019171ee772034ffc31e0732f2",
      "summary": "赵执事把借五还六改成借五还七，又以住庙抵债相逼。阿蘅选择做工还粮，病中的母亲却仍需她照顾。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e04",
      "revision_id": "dc129a3e23ae4edaabfef5a93d5b8dce1072a7f0fedfa00ef01427398d45a2ba",
      "summary": "庙会祈福戏里，红绳和刮过的木牌引起怀疑；神梦点出第三个名字。争抢木牌使李寄受伤，阿蘅回家表明不愿献祭。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e05",
      "revision_id": "9d4c9925b2854dc31c73f16226ab1e11ae5c446b719da7774f72c5b76dacccbb",
      "summary": "求船离开与还粮两条路都走不通。李寄得知应募查验可暂缓三日，李诞决定由自己承担，先与家人说清行动和退路。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e06",
      "revision_id": "0ceacdb8bb9239dd48faa254dda1af6d2f9c3e255733ef67f4607de02dfb2938",
      "summary": "孙六加入应募，李家公开把阿蘅母女接回家中。众人守夜，并在查验前追问庙里究竟怎样喂蛇。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e07",
      "revision_id": "5e63352482117cd4f12a2e539f3f2384bedc151f52413d4a8a69d2bd3e321c1d",
      "summary": "李诞等人正式应募，纠正文书里的“自愿入祀”。阿蘅亲口说出不愿意，取得有明确边界的本次免祭条款。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e08",
      "revision_id": "3ad11fd3cbd4616d7df85a73f630b964019664355f32398792f2346227f48898",
      "summary": "众人查验庙后唯一上锁的门和两门间的短石道，弄清交替喂食的机关，也发现先前女孩是被强迫送入。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e09",
      "revision_id": "1cbbb8350585b18e63a0ffe9b1aa65572c946d4ffe998aa6670abbfafbf8ce01",
      "summary": "周掌柜带来提前一天的备粮单，成为查祭的线索。众人推动调查期间不得索人，揭开借据贴纸，并召集改闸的人手。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e10",
      "revision_id": "f831ff31ab9e6a97cd60733d5b2cfdd77abffadd742f6c573ca0ebf3dfa3b2d0",
      "summary": "众人改造闭闸和刀缝，以湿草练刀、七人试压，给李诞留出备用位置。阿蘅母亲辨认借据，墨耳留在家中。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e11",
      "revision_id": "270c2b8bb6656cdcb771e68c47ef4235e890e18c7de4dd28f31a45ac0ebfd05f",
      "summary": "斩蛇前再次核清饵、刀位、退路与停手办法。阿蘅选择到场，李寄家备好灯和饭，众人按分工等待次日行动。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e12",
      "revision_id": "8e1ed1a45c319479f8be6235e3ea04ccd39725ef913b79a6ba140abd5720cc14",
      "summary": "阿蘅当众拒绝献祭，原单和底账进入查验；祭册被封存，粮照票发放。后门保留求援通路，众人转入执行。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e13",
      "revision_id": "27f3df6d68cb8029d2e22d22ea999f4c53c810c2e960aa38d6467cb78c3de619",
      "summary": "起压时七人力量不足，李诞放下刀绕到东侧补位。阿蘅去叫援手，李寄在父亲核看门闩与石盖后主动请试。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e14",
      "revision_id": "ef2a6beda9c6ae8b0b648ec580051901105f5abd1411363c6dcba6d8b7d5ad58",
      "summary": "李寄怕痛，也曾下偏刀；她停住重新找准，再继续落刀。八人持续压闸，后来赶到的援手按次序换力。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e15",
      "revision_id": "edb0806914188d541c4b8170e478ab774e5d9e63905c292777f11d18ae62c3a6",
      "summary": "斩蛇后众人回家吃上热饭，两户为遇害女孩默哀。周掌柜的店账与提前备粮单被带去核对，追责开始。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e16",
      "revision_id": "e7c1e5e0cd3ceed9adb8df4e1569190ebdfac88f659f78b1a2f905b467fc7cb9",
      "summary": "众人追问强迫送人的经过和县衙责任。二十多天后复查定罪，人祭被永久废除，旧债与祭粮逐项清理。"
    },
    {
      "object_id": "screenplay-01-lantern-home-e17",
      "revision_id": "2f8600a6c3e899ac95b6d55854c80d7504021fe6a4120585be6d6a8f2aefd51b",
      "summary": "阿蘅找回替唱歌娘补全缺词，李寄与她轮流抄本，旧水痕仍留着。歌终于完整唱出，两人提灯走回家。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e01",
      "revision_id": "26d43ae7b6985e4b857e73355c45d11a0079e07cf8eb0483d8c6e7927bc97d9e",
      "summary": "阿蘅在米铺唱曲换米，接下许家的试唱；李寄帮她拿歌本。赵执事随后邀阿蘅去庙里领唱，旧日祭女的遭遇让李寄不安。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e02",
      "revision_id": "4428d2228b1ac5f4a3cd0789622570c58cefd697368d0907cb6030ed8ac58127",
      "summary": "李寄因担心阿蘅被送祭而把歌本抛进河里。两人捞回湿透的书，阿蘅失去许家的差事并退回预付米，李寄开始赔补。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e03",
      "revision_id": "dd77fe59e3d6baaea09feae5435c294f39b497d838dfa1f14004e0f957d25fce",
      "summary": "李寄帮阿蘅补本，许家差事留下的缺口仍在。十来天后，赵执事以借据和抵粮条件邀她住庙唱歌，新纸下藏着被改过的欠数。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e04",
      "revision_id": "100114f2a6e87c162ed2d2171739d9275231845256bd956086988fa49f23fcea",
      "summary": "阿蘅为挣工钱参加庙会祈福戏，戏台纸月亮卡在蛇嘴里。红绳和木牌留下疑点，祭女点名逼近她。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e05",
      "revision_id": "4b3036cb6cd6b8b9d964e95a629b39bb9716ba7e2a268d944205532e1272e385",
      "summary": "被点名后，阿蘅在李寄和李绡陪伴下离开庙院。回家面对母亲，她说出自己不愿去，庙工却仍守在门外。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e06",
      "revision_id": "91452630204d57ca83184e341da84596231753e18f5f0214e7c5136e1a3fd70a",
      "summary": "李寄先求船带阿蘅离开，又想代她还粮，两条路都被挡住。衙门木牌写着应募查验可暂缓三日，她转身回家求助。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e07",
      "revision_id": "c8a8be470bbf736d4aa80863bf3c490932b5d5d2efe0192cf94f331ff20d75a8",
      "summary": "李诞听女儿讲完，把应募视为自己该承担的事。母亲追问帮手和退路，他逐一说清，家人备好褥子与饭，等他出门。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e08",
      "revision_id": "4b4f6690379774548eff7082da3aaeaf5ea9d143a95ee96449a4f63ff48649be",
      "summary": "李诞带孙六和李绡把阿蘅母女接到李家，安顿病母并守过一夜。天亮后众人先问清喂蛇的办法，再一同去衙门。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e09",
      "revision_id": "0e73e737e236b3f311de0e46c63611705c2db4f4ac13223c31977f1aab73101c",
      "summary": "李诞、孙六等人报上姓名与工具，纠正文书里的“自愿入祀”。阿蘅亲自说明不愿意，众人争得有边界的本次免祭。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e10",
      "revision_id": "4602e0ec45d200f0899e4e8b20b1457543418bc110795b00de702d660167a739",
      "summary": "两人过桥时，李寄把说话机会留给阿蘅。众人上山查验后门与木闸，确认高墙后只有封闭短石道，不能让女孩钻进去。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e11",
      "revision_id": "c1488820d6bea080207a73db3ea0b609405228eae7315d53e0af040ffece98b3",
      "summary": "庙工演示两道门交替开闭，短石道内的痕迹暴露先前送人的真相。阿蘅追问阿禾从哪里进去，李诞开始考虑从外侧落闸下刀。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e12",
      "revision_id": "6f46b6543fdc31ddc4ac9ebfa6c5fc2cef22bea6d2510e1917f8286bc46b38a9",
      "summary": "周掌柜带来提前一天的备粮单。衙门宣布调查期间不得再索人，阿蘅与母亲辨认借据贴纸下被添上的字，账箱重新封存。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e13",
      "revision_id": "9a2355628e924e84b0036bbd25689863fa272230fcf99d4d7bd7f6ae6b06fdf2",
      "summary": "孙六带来四名乡亲，众人在封闭石道外改刀缝、试湿草，再以七人预演压杠。东侧留下一个备用位置，等真正行动时补力。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e14",
      "revision_id": "110254ac7a2ca2ba11cca938e8d6ea1965750bc23766142aa4a33df517a4ae02",
      "summary": "陶伯提醒绳子别磨石角，后门和祭册继续封存。阿蘅母亲辨认借据上并非自己按下的字，众人围着通道图讲清可停、可退的办法。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e15",
      "revision_id": "782c582b46c93c41e32223d827efa41c1b83f6c47afda3018b46aaf8db453439",
      "summary": "祭日清晨，李家带上尚未点亮的灯。阿蘅在领粮乡亲面前说清自己从未答应献祭，众人核对粮票后转向后门。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e16",
      "revision_id": "1f6722d8cf21333df880dc2c22184f0ee8ce302d0a47d1f1dcd0c78d1f09217b",
      "summary": "众人按约守住门道，七人压闸却不够，李诞放刀绕到东侧补位。阿蘅守门求援，李寄面对父亲留下的刀位。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e17",
      "revision_id": "949d5e844e1845861c9ee3b989969760b13b8985c13c8ead88e3771c011faad9",
      "summary": "李寄主动请试，握刀打滑时先放下重握，偏刀后又停住找准。八人持续压闸，外头援手到来后按分工等待换力。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e18",
      "revision_id": "eee1fbb833d9fa04584e438c19aa7baea77a8cc50f0ba614536e67cc8109a976",
      "summary": "确认刀已放稳，援手才接替杠外的人；庙里继续留人看守。李寄、阿蘅和家人回到饭桌前，终于能坐下吃热饭。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e19",
      "revision_id": "5777e5cabb4703ca2caf56bc2b255dddbe0cf3a7785473b48401d4d48e7e1d03",
      "summary": "众人辨认洞中清出的竹簪与断梳，为遇害女孩留出静默。祭册、借据、粮单和店账并列核查，迫送女孩的责任逐渐清楚。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e20",
      "revision_id": "1740acd20822c966c33dc89d12517aabc42657cdb513e804c243a5020770a3a4",
      "summary": "二十多天后，复查结果写明旧案与清账办法。阿蘅亲自核对归还的粮，又和母亲整理旧歌本，准备去寻能补词的歌娘。"
    },
    {
      "object_id": "screenplay-02-lantern-home-e21",
      "revision_id": "9977e0811bbd99bfd0eaeb30772eeb171a9fd21708ecae877a4806f1383c90a8",
      "summary": "歌娘帮阿蘅找回缺失的唱词，李寄陪她重新抄本、试唱。一个多月后歌声唱完整，两人把灯带回各自家门前。"
    }
  ]
}

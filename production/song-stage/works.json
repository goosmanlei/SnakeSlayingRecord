  "works": [
    {
      "entity_id": "entity-boat-song",
      "title": "三道滩",
      "lyrics_file": "lyrics/boat.md",
      "lyrics_sha256": "5b15b745dbb925a5f296cf7401300c7c14db0b009c2be34109bb6e6dd8f268b3",
      "lines": [
        {
          "id": "boat-01-01",
          "section": "试水",
          "text": "一道险滩水急，"
        },
        {
          "id": "boat-01-02",
          "section": "试水",
          "text": "船头慢慢行。"
        },
        {
          "id": "boat-01-03",
          "section": "试水",
          "text": "莫催这一双摇桨手，"
        },
        {
          "id": "boat-01-04",
          "section": "试水",
          "text": "水深水浅试分明。"
        },
        {
          "id": "boat-02-01",
          "section": "顶风",
          "text": "二道险滩弯又急，"
        },
        {
          "id": "boat-02-02",
          "section": "顶风",
          "text": "迎面起寒风。"
        },
        {
          "id": "boat-02-03",
          "section": "顶风",
          "text": "低下身来收紧篷，"
        },
        {
          "id": "boat-02-04",
          "section": "顶风",
          "text": "一篙撑过乱石中。"
        },
        {
          "id": "boat-03-01",
          "section": "见灯",
          "text": "三道险滩暮色深，"
        },
        {
          "id": "boat-03-02",
          "section": "见灯",
          "text": "远远望见灯。"
        },
        {
          "id": "boat-03-03",
          "section": "见灯",
          "text": "岸上有人喊一声，"
        },
        {
          "id": "boat-03-04",
          "section": "见灯",
          "text": "我也笑着应一声。"
        },
        {
          "id": "boat-04-01",
          "section": "靠岸",
          "text": "过了滩，转了湾，"
        },
        {
          "id": "boat-04-02",
          "section": "靠岸",
          "text": "桨上水声轻。"
        },
        {
          "id": "boat-04-03",
          "section": "靠岸",
          "text": "船靠岸，灯来迎，"
        },
        {
          "id": "boat-04-04",
          "section": "靠岸",
          "text": "家里人等到如今。"
        }
      ],
      "lyrics_acceptance": null,
      "music_acceptance": null,
      "audio_acceptance": null,
      "audio_masters": [],
      "clips": []
    },
    {
      "entity_id": "entity-blue-awning-song",
      "title": "送青篷",
      "lyrics_file": "lyrics/blue-awning.md",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "lines": [
        {
          "id": "blue-awning-01-01",
          "section": "第一段 · 送行",
          "text": "青篷起，水轻摇，"
        },
        {
          "id": "blue-awning-01-02",
          "section": "第一段 · 送行",
          "text": "送你过了石板桥。"
        },
        {
          "id": "blue-awning-01-03",
          "section": "第一段 · 送行",
          "text": "桨莫急，缆慢抛，"
        },
        {
          "id": "blue-awning-01-04",
          "section": "第一段 · 送行",
          "text": "岸上叮咛还未了。"
        },
        {
          "id": "blue-awning-01-05",
          "section": "第一段 · 送行",
          "text": "新裁衣，旧布袄，"
        },
        {
          "id": "blue-awning-01-06",
          "section": "第一段 · 送行",
          "text": "船上风凉都带好。"
        },
        {
          "id": "blue-awning-01-07",
          "section": "第一段 · 送行",
          "text": "隔着河湾听不清，"
        },
        {
          "id": "blue-awning-01-08",
          "section": "第一段 · 送行",
          "text": "只见你在船头笑。"
        },
        {
          "id": "blue-awning-02-01",
          "section": "第二段 · 相照",
          "text": "青篷过河湾，"
        },
        {
          "id": "blue-awning-02-02",
          "section": "第二段 · 相照",
          "text": "柳影到船边。"
        },
        {
          "id": "blue-awning-02-03",
          "section": "第二段 · 相照",
          "text": "莫怕远山高，"
        },
        {
          "id": "blue-awning-02-04",
          "section": "第二段 · 相照",
          "text": "隔水灯相照。"
        },
        {
          "id": "blue-awning-02-05",
          "section": "第二段 · 相照",
          "text": "明年春水暖，"
        },
        {
          "id": "blue-awning-02-06",
          "section": "第二段 · 相照",
          "text": "归来认旧桥。"
        }
      ],
      "lyrics_acceptance": null,
      "music_acceptance": null,
      "audio_acceptance": null,
      "audio_masters": [],
      "clips": []
    },
    {
      "entity_id": "entity-snake-welcome-song",
      "title": "四邻安",
      "lyrics_file": "lyrics/welcome.md",
      "lyrics_sha256": "96a3d50ba2de4187233f50469eb10e1a9ddc661d1f65aabbc25576859b83aca8",
      "lines": [
        {
          "id": "welcome-01-01",
          "section": "第一段 · 奉饵",
          "text": "领：米饵奉蛇神，"
        },
        {
          "id": "welcome-01-02",
          "section": "第一段 · 奉饵",
          "text": "众：四邻得安宁。"
        },
        {
          "id": "welcome-01-03",
          "section": "第一段 · 奉饵",
          "text": "领：香火堂前点，"
        },
        {
          "id": "welcome-01-04",
          "section": "第一段 · 奉饵",
          "text": "众：愿护满村人。"
        },
        {
          "id": "welcome-02-01",
          "section": "第二段 · 祈愿",
          "text": "领：田里禾苗壮，"
        },
        {
          "id": "welcome-02-02",
          "section": "第二段 · 祈愿",
          "text": "众：家家米满囤。"
        },
        {
          "id": "welcome-02-03",
          "section": "第二段 · 祈愿",
          "text": "领：河上风浪小，"
        },
        {
          "id": "welcome-02-04",
          "section": "第二段 · 祈愿",
          "text": "众：船家早归门。"
        },
        {
          "id": "welcome-03-01",
          "section": "第三段 · 续香火",
          "text": "领：今朝齐俯首，"
        },
        {
          "id": "welcome-03-02",
          "section": "第三段 · 续香火",
          "text": "众：香火续来春。"
        },
        {
          "id": "welcome-03-03",
          "section": "第三段 · 续香火",
          "text": "领：庙前灯不灭，"
        },
        {
          "id": "welcome-03-04",
          "section": "第三段 · 续香火",
          "text": "众：愿得岁岁宁。"
        },
        {
          "id": "welcome-04-01",
          "section": "齐唱收束",
          "text": "合：米饵奉蛇神，"
        },
        {
          "id": "welcome-04-02",
          "section": "齐唱收束",
          "text": "四邻得安宁。"
        }
      ],
      "lyrics_acceptance": null,
      "music_acceptance": null,
      "audio_acceptance": null,
      "audio_masters": [],
      "clips": []
    },
    {
      "entity_id": "entity-blessing-stage-song",
      "title": "明月还乡",
      "lyrics_file": "lyrics/blessing.md",
      "lyrics_sha256": "946cf5d404cc27e4246cbec3f890c882d815ac92a09eb8f58365224c3fa0ac4e",
      "lines": [
        {
          "id": "blessing-01-01",
          "section": "见月",
          "text": "月从柳梢上，"
        },
        {
          "id": "blessing-01-02",
          "section": "见月",
          "text": "清光照苇塘。"
        },
        {
          "id": "blessing-01-03",
          "section": "见月",
          "text": "收网的小船归来晚，"
        },
        {
          "id": "blessing-01-04",
          "section": "见月",
          "text": "一盏渔灯水上晃。"
        },
        {
          "id": "blessing-02-01",
          "section": "吞月",
          "text": "黑云山口起，"
        },
        {
          "id": "blessing-02-02",
          "section": "吞月",
          "text": "大蛇把口张。"
        },
        {
          "id": "blessing-02-03",
          "section": "吞月",
          "text": "一轮明月吞入腹，"
        },
        {
          "id": "blessing-02-04",
          "section": "吞月",
          "text": "两岸失清光。"
        },
        {
          "id": "blessing-03-01",
          "section": "还月",
          "text": "摆开香案点明灯，"
        },
        {
          "id": "blessing-03-02",
          "section": "还月",
          "text": "捧来米饵满满筐。"
        },
        {
          "id": "blessing-03-03",
          "section": "还月",
          "text": "米饵献上，明月还乡，"
        },
        {
          "id": "blessing-03-04",
          "section": "还月",
          "text": "一河清光照门窗。"
        },
        {
          "id": "blessing-04-01",
          "section": "归家",
          "text": "月照桥，月照窗，"
        },
        {
          "id": "blessing-04-02",
          "section": "归家",
          "text": "月照田头稻谷香。"
        },
        {
          "id": "blessing-04-03",
          "section": "归家",
          "text": "家家灯火留一盏，"
        },
        {
          "id": "blessing-04-04",
          "section": "归家",
          "text": "等得夜行人还乡。"
        }
      ],
      "lyrics_acceptance": null,
      "music_acceptance": null,
      "audio_acceptance": null,
      "audio_masters": [],
      "clips": []
    }
  ]
}

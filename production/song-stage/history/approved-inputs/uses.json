    {
      "id": "use-12",
      "song_entity": "entity-snake-welcome-song",
      "lyrics_sha256": "96a3d50ba2de4187233f50469eb10e1a9ddc661d1f65aabbc25576859b83aca8",
      "source": {
        "object_id": "screenplay-04-lantern-home-e03",
        "revision_id": "561c690a2040b7ffb25ceaa18b3246902d33d57614caa63ff47678cabc0156bd",
        "scene_id": "s006",
        "block_ids": [

        "scene_id": "s007",
        "block_ids": [
          "screenplay-04-lantern-home-s007-b001"
        ],
        "text": [
          "前殿里，阿蘅站在十几个领唱的人中间，跟着唱完长句。殿门外还是亮的。"
        ]
      },
      "mode": "group_singing",

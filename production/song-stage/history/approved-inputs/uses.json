          "screenplay-04-lantern-home-s041-b011",
          "screenplay-04-lantern-home-s041-b012"
        ],
        "text": [
          "阿蘅（唱）：青篷过河湾，柳影到船边——",
          "李寄的手停在新旧两页交接处，抬眼望向阿蘅。"
        ]
      },
      "mode": "complete_second_section_opening",
      "performer": "阿蘅",

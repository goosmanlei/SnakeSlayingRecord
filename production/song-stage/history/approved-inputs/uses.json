    {
      "id": "use-29",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e17",
        "revision_id": "86472299d571ceb960315b77be5e782e2153575aa4bfe44dead0c3fcc1818fd8",
        "scene_id": "s041",
        "block_ids": [
          "screenplay-04-lantern-home-s041-b013",
          "screenplay-04-lantern-home-s041-b014",
          "screenplay-04-lantern-home-s041-b015"
        ],
        "text": [
          "阿蘅（唱）：莫怕远山高，隔水灯相照。明年春水暖，归来认旧桥——",
          "最后一个音在晒场上拖开，慢慢收住。",
          "李寄这才松开压着页边的手。阿蘅转过脸，两人隔着半幅幕布笑了一下。"
        ]
      },
      "mode": "complete_song_ending",
      "performer": "阿蘅",
      "lyric_selection": "blue-awning-02-03—06",
      "treatment": "完整收腔后才掌声；掌声不进入歌曲母版",
      "existing_shot": null,

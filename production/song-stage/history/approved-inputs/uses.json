    {
      "id": "use-15",
      "song_entity": "entity-blessing-stage-song",
      "lyrics_sha256": "946cf5d404cc27e4246cbec3f890c882d815ac92a09eb8f58365224c3fa0ac4e",
      "source": {
        "object_id": "screenplay-04-lantern-home-e04",
        "revision_id": "e720c535cacff062ee5bacc9b6cd9bba6664afd9155f15b6ad1475eeed2c66f2",
        "scene_id": "s008",
        "block_ids": [
          "screenplay-04-lantern-home-s008-b001",
          "screenplay-04-lantern-home-s008-b012",
          "screenplay-04-lantern-home-s008-b027",
          "screenplay-04-lantern-home-s008-b037"
        ],
        "text": [
          "鼓点急起来，纸蛇追着月亮上下摆头，台下的孩子齐声叫好。",
          "鼓声再起。李寄放低纸月亮，让蛇含牢。台上人献米饵，孩子们伸长脖子，等着月亮出来。",
          "李绡抬手，孙六停鼓。牵线的李寄也停住，纸蛇张着嘴，月亮卡在里面。",
          "李寄手里还攥着牵线。纸月亮停在半张的蛇嘴里。"
        ]
      },
      "mode": "stage_context_no_explicit_singing",
      "performer": "戏班",
      "lyric_selection": "未指定唱词",
      "treatment": "纸蛇含月、献饵与鼓点作为戏中戏情境依据；原场被打断、纸月亮没有吐出，不追加唱词或完整还月结尾",
      "existing_shot": null,
      "master": null,

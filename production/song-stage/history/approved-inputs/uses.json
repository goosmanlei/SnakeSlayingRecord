      "source": {
        "object_id": "screenplay-04-lantern-home-e05",
        "revision_id": "8c58f966aca376091e4d555e1dec53506d537b79a9344efba97054fb7fbac04b",
        "scene_id": "s010",
        "block_ids": [
          "screenplay-04-lantern-home-s010-b010",
          "screenplay-04-lantern-home-s010-b011"
        ],
        "text": [
          "远处祈福戏重新响起。唱腔顺着河面飘来：“米饵献上，明月还乡——”随后是一阵喝彩。",
          "母女还抱着，没有抬头。"
        ]
      },
      "mode": "distant_stage_singing",
      "performer": "庙中未具名戏唱者",
      "lyric_selection": "blessing-03-03",
      "treatment": "先干净演唱，再另制远处河面传声；喝彩独立，不混入母版",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-17",
      "song_entity": "entity-snake-welcome-song",
      "lyrics_sha256": "96a3d50ba2de4187233f50469eb10e1a9ddc661d1f65aabbc25576859b83aca8",
      "source": {
        "object_id": "screenplay-04-lantern-home-e07",
        "revision_id": "b57f260623beb1ffdcb32e77afdd9c65f831e297ccd82b91ad176e49b599aa19",
        "scene_id": "s017",
        "block_ids": [
          "screenplay-04-lantern-home-s017-b030"
        ],
        "text": [
          "阿蘅：我答应庙里唱迎蛇调，我可没有答应要去拿自己喂蛇。"
        ]
      },
      "mode": "mention",
      "performer": "阿蘅",
      "lyric_selection": "无新增唱词",
      "treatment": "明确只答应唱迎蛇调，不同意献身，保留对白",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-18",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e16",
        "revision_id": "94ca5b3b1fa8e9acc7a25d7918904c8a8147cdd572c879b6c894ad4f517412d2",
        "scene_id": "s038",
        "block_ids": [
          "screenplay-04-lantern-home-s038-b003",
          "screenplay-04-lantern-home-s038-b006"
        ],
        "text": [
          "窗台上摊着泡皱的旧页，旁边是李寄先前补抄的新纸。“柳影到船边”之后，仍空着半行。",
          "阿蘅：先去问。娘想起几句，后头还是断着。五姐说，后来替许家唱歌的那位，回邻村了。"
        ]
      },
      "mode": "page_and_mention",
      "performer": "歌页；阿蘅",
      "lyric_selection": "blue-awning-02-02 之后仍空缺",
      "treatment": "只在尚缺词阶段呈现旧残页，不提前露出新歌词",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-19",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e16",
        "revision_id": "94ca5b3b1fa8e9acc7a25d7918904c8a8147cdd572c879b6c894ad4f517412d2",
        "scene_id": "s038",
        "block_ids": [
          "screenplay-04-lantern-home-s038-b009",
          "screenplay-04-lantern-home-s038-b010",
          "screenplay-04-lantern-home-s038-b011"
        ],
        "text": [
          "母亲在床边轻轻哼起来。阿蘅听见，接上她的调。",
          "阿蘅（唱）：青篷过河湾，柳影到船边——",
          "母女的声音在同一处停下。母亲摇摇头，阿蘅没有再催她想。"
        ]
      },
      "mode": "mother_humming_daughter_singing",
      "performer": "母亲、阿蘅",
      "lyric_selection": "blue-awning-02-01—02",
      "treatment": "母亲先哼，阿蘅接唱；两人在船边同停，需两种真实声线",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-20",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e16",
        "revision_id": "94ca5b3b1fa8e9acc7a25d7918904c8a8147cdd572c879b6c894ad4f517412d2",
        "scene_id": "s039",
        "block_ids": [
          "screenplay-04-lantern-home-s039-b004",
          "screenplay-04-lantern-home-s039-b005",
          "screenplay-04-lantern-home-s039-b006"
        ],
        "text": [
          "阿蘅跟着拍子，唱出《送青篷》的第二段。",
          "阿蘅（唱）：青篷过河湾，柳影到船边——",
          "她看向缺词处。歌娘接住未收的调子。"
        ]
      },
      "mode": "sung_lead_in",
      "performer": "阿蘅",
      "lyric_selection": "blue-awning-02-01—02",
      "treatment": "留下可接的调子，歌娘接句，不能先做全曲终止",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-21",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e16",
        "revision_id": "94ca5b3b1fa8e9acc7a25d7918904c8a8147cdd572c879b6c894ad4f517412d2",
        "scene_id": "s039",
        "block_ids": [
          "screenplay-04-lantern-home-s039-b007"
        ],
        "text": [
          "歌娘（唱）：莫怕远山高，隔水灯相照。明年春水暖，归来认旧桥——"
        ]
      },
      "mode": "teaching_singing",
      "performer": "歌娘",
      "lyric_selection": "blue-awning-02-03—06",
      "treatment": "成熟女声自然接唱，独立干净片段",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-22",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e16",
        "revision_id": "94ca5b3b1fa8e9acc7a25d7918904c8a8147cdd572c879b6c894ad4f517412d2",
        "scene_id": "s039",
        "block_ids": [
          "screenplay-04-lantern-home-s039-b008",
          "screenplay-04-lantern-home-s039-b009",
          "screenplay-04-lantern-home-s039-b010",
          "screenplay-04-lantern-home-s039-b011",
          "screenplay-04-lantern-home-s039-b012"
        ],
        "text": [
          "李寄低头记，写到末句停住。阿蘅正要从头接唱，她轻轻举起笔。",
          "李寄：最后是“过旧桥”，还是“认旧桥”？",
          "歌娘：认。回来认得自家的桥。再听一遍。",
          "歌娘放慢拍子，唱到“归来”，稍作换气，让后面三个字一个个落清。",
          "李寄写好，把夹板递给她。歌娘指过每一行，补正一个写歪的字，点头。"
        ]
      },
      "mode": "word_check_and_slow_repeat",
      "performer": "李寄、歌娘",
      "lyric_selection": "blue-awning-02-05—06，重点认旧桥",
      "treatment": "对白仍核过／认；归来后换气，认旧桥逐字落清，另演慢版",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-23",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e16",
        "revision_id": "94ca5b3b1fa8e9acc7a25d7918904c8a8147cdd572c879b6c894ad4f517412d2",
        "scene_id": "s039",
        "block_ids": [
          "screenplay-04-lantern-home-s039-b013",
          "screenplay-04-lantern-home-s039-b014",
          "screenplay-04-lantern-home-s039-b015",
          "screenplay-04-lantern-home-s039-b016",
          "screenplay-04-lantern-home-s039-b017",
          "screenplay-04-lantern-home-s039-b018"
        ],
        "text": [
          "阿蘅重新起唱。",
          "阿蘅（唱）：青篷过河湾，柳影到船边。莫怕远山高，隔水灯相照——",
          "歌娘只在换气处轻拍一下膝盖，等她自己往下唱。",
          "阿蘅（唱）：明年春水暖，归来认旧桥——",
          "尾音落下，阿蘅还望着纸。歌娘的手不再打拍，朝她笑了笑。",
          "歌娘：连上了。"
        ]
      },
      "mode": "reconnected_singing",
      "performer": "阿蘅",
      "lyric_selection": "blue-awning-02-01—06",
      "treatment": "完整重唱第二段；歌娘膝上点拍不并入干净演唱",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-24",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e16",
        "revision_id": "94ca5b3b1fa8e9acc7a25d7918904c8a8147cdd572c879b6c894ad4f517412d2",
        "scene_id": "s039",
        "block_ids": [
          "screenplay-04-lantern-home-s039-b019",
          "screenplay-04-lantern-home-s039-b020"
        ],
        "text": [
          "阿蘅也笑出来，随即又低头唱那句曾经缺掉的词。",
          "李寄这次没赶着记。她抱着夹板，听阿蘅唱完。头顶的晾衣绳轻轻晃，旧红袖在两人身旁拂过。"
        ]
      },
      "mode": "sung_repeat",
      "performer": "阿蘅",
      "lyric_selection": "拟选 blue-awning-02-03—06",
      "treatment": "再唱曾缺掉的词，另演更放松的完整乐句",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-25",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e17",
        "revision_id": "86472299d571ceb960315b77be5e782e2153575aa4bfe44dead0c3fcc1818fd8",
        "scene_id": "s040",
        "block_ids": [
          "screenplay-04-lantern-home-s040-b001"
        ],
        "text": [
          "灯下，新纸铺在两人中间。阿蘅对着歌娘核过的词慢慢念，李寄照着写。床边，阿蘅母亲低声跟着调子。"
        ]
      },
      "mode": "spoken_lyrics_with_humming",
      "performer": "阿蘅念词；母亲轻声跟调",
      "lyric_selection": "拟选 blue-awning-02-03—06",
      "treatment": "念词不是演唱，母亲哼声单独处理；具体念词范围为制作选择",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-26",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e17",
        "revision_id": "86472299d571ceb960315b77be5e782e2153575aa4bfe44dead0c3fcc1818fd8",
        "scene_id": "s040",
        "block_ids": [
          "screenplay-04-lantern-home-s040-b010",
          "screenplay-04-lantern-home-s040-b011",
          "screenplay-04-lantern-home-s040-b012",
          "screenplay-04-lantern-home-s040-b013"
        ],
        "text": [
          "李寄替她翻到前页，阿蘅从熟悉的地方低声起唱。唱到“柳影到船边”，李寄先抬起眼。",
          "阿蘅朝她笑了一下，接下去。",
          "阿蘅（唱）：莫怕远山高，隔水灯相照——",
          "床边的母亲用指尖跟了一拍，自己轻轻哼完末句。阿蘅没有停在原来那块空白前。"
        ]
      },
      "mode": "soft_singing_then_mother_humming",
      "performer": "阿蘅、母亲",
      "lyric_selection": "blue-awning-02-01—04；母亲哼 blue-awning-02-05—06",
      "treatment": "歌者接力，母亲轻哼末句；不得用独立版一人替代",
      "existing_shot": null,
      "master": null,
      "clip": null,
      "master_range_seconds": null,
      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-27",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e17",
        "revision_id": "86472299d571ceb960315b77be5e782e2153575aa4bfe44dead0c3fcc1818fd8",

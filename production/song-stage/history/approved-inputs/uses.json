        "block_ids": [
          "screenplay-04-lantern-home-s041-b009",
          "screenplay-04-lantern-home-s041-b010"
        ],
        "text": [
          "阿蘅（唱）：青篷起，水轻摇，送你过了石板桥。桨莫急，缆慢抛，岸上叮咛还未了——",
          "母亲在膝头轻打拍子。阿蘅的尾音落稳，换一口气。"
        ]
      },
      "mode": "complete_first_section",
      "performer": "阿蘅",
      "lyric_selection": "blue-awning-01-01—08",
      "treatment": "拟改唱词块后唱全第一段，不省掉新增四行；完整场次在 s041-proposed.md",
      "existing_shot": null,
      "master": null,
      "clip": null,

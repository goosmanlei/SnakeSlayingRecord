        "block_ids": [
          "screenplay-04-lantern-home-s003-b015"
        ],
        "text": [
          "河边，阿蘅抖开湿幕布，低声练着《送青篷》。李寄望着她，又低头看那行庙歌。"
        ]
      },
      "mode": "quiet_practice",
      "performer": "阿蘅",
      "lyric_selection": "拟选 blue-awning-01-01—04",

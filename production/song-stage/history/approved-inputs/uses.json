      "clip_range_seconds": null,
      "voice_asset": null,
      "status": "planned_not_produced"
    },
    {
      "id": "use-28",
      "song_entity": "entity-blue-awning-song",
      "lyrics_sha256": "089d45382445f14e626fc401d87ac69a05340747890e39f601337054276df4fc",
      "source": {
        "object_id": "screenplay-04-lantern-home-e17",
        "revision_id": "86472299d571ceb960315b77be5e782e2153575aa4bfe44dead0c3fcc1818fd8",

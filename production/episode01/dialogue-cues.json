[
  {
    "type": "singing",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "一道险滩水急，船头慢慢行——",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b002"
      ]
    },
    "id": "e01-line-001",
    "shot_id": "shot-e01-001",
    "planned_start_frame": 12,
    "planned_end_frame": 204,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "singing",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "船靠岸，灯来迎，家里人等到如今——",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b004"
      ]
    },
    "id": "e01-line-002",
    "shot_id": "shot-e01-003",
    "planned_start_frame": 12,
    "planned_end_frame": 228,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "老汉",
    "entity": {
      "object_id": "entity-woodcutter",
      "revision_id": "3241525a58e7c75081855883fd97a60f8fef9a54f3df1cd8cc48025d8fb2136c"
    },
    "text": "二道——哎，到了？",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b005"
      ]
    },
    "id": "e01-line-003",
    "shot_id": "shot-e01-004",
    "planned_start_frame": 12,
    "planned_end_frame": 43,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "老汉",
    "entity": {
      "object_id": "entity-woodcutter",
      "revision_id": "3241525a58e7c75081855883fd97a60f8fef9a54f3df1cd8cc48025d8fb2136c"
    },
    "text": "昨天还得过三道滩，走大半天呢，今天这么快？",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b007"
      ]
    },
    "id": "e01-line-004",
    "shot_id": "shot-e01-004",
    "planned_start_frame": 43,
    "planned_end_frame": 156,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "您昨天都陪他走了一路啦。今天让他早些到家，您也少站一会儿。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b008"
      ]
    },
    "id": "e01-line-005",
    "shot_id": "shot-e01-005",
    "planned_start_frame": 12,
    "planned_end_frame": 180,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "一位听客",
    "entity": {
      "object_id": "entity-rice-listeners",
      "revision_id": "18da50dde8e39dd6682b6a4cca9ed19781bb28c7007265ed28b8b8ec64aa76da"
    },
    "text": "下回补上",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b009"
      ]
    },
    "id": "e01-line-006",
    "shot_id": "shot-e01-006",
    "planned_start_frame": 12,
    "planned_end_frame": 84,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "这两段，练熟了没有？",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b012"
      ]
    },
    "id": "e01-line-007",
    "shot_id": "shot-e01-008",
    "planned_start_frame": 12,
    "planned_end_frame": 76,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "留着下回唱给你。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b013"
      ]
    },
    "id": "e01-line-008",
    "shot_id": "shot-e01-008",
    "planned_start_frame": 76,
    "planned_end_frame": 132,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "我又不给米。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b014"
      ]
    },
    "id": "e01-line-009",
    "shot_id": "shot-e01-008",
    "planned_start_frame": 132,
    "planned_end_frame": 172,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "所以你得听全，少一句都不许跑。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b016"
      ]
    },
    "id": "e01-line-010",
    "shot_id": "shot-e01-008",
    "planned_start_frame": 172,
    "planned_end_frame": 276,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "周掌柜",
    "entity": {
      "object_id": "entity-zhou",
      "revision_id": "a983783f1095d60f2c8339167c0b22287ff50d51b49e28b4818146adfe532d4b"
    },
    "text": "这是今天的。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b018"
      ]
    },
    "id": "e01-line-011",
    "shot_id": "shot-e01-009",
    "planned_start_frame": 12,
    "planned_end_frame": 156,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "周掌柜",
    "entity": {
      "object_id": "entity-zhou",
      "revision_id": "a983783f1095d60f2c8339167c0b22287ff50d51b49e28b4818146adfe532d4b"
    },
    "text": "明天许家嫁女儿，要唱《送青篷》。你娘说你能唱，我替你应下了。傍晚先来唱一遍，可不能也省两段。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b020"
      ]
    },
    "id": "e01-line-012",
    "shot_id": "shot-e01-010",
    "planned_start_frame": 12,
    "planned_end_frame": 324,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "这回不省。您放心。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b022"
      ]
    },
    "id": "e01-line-013",
    "shot_id": "shot-e01-011",
    "planned_start_frame": 12,
    "planned_end_frame": 84,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "周掌柜",
    "entity": {
      "object_id": "entity-zhou",
      "revision_id": "a983783f1095d60f2c8339167c0b22287ff50d51b49e28b4818146adfe532d4b"
    },
    "text": "这把先付你。唱成了，明天的报酬够你家吃几天。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b024"
      ]
    },
    "id": "e01-line-014",
    "shot_id": "shot-e01-012",
    "planned_start_frame": 12,
    "planned_end_frame": 159,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "谢谢周叔。我傍晚就来。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b025"
      ]
    },
    "id": "e01-line-015",
    "shot_id": "shot-e01-012",
    "planned_start_frame": 159,
    "planned_end_frame": 228,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "最后那段，你还得看词呢。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b027"
      ]
    },
    "id": "e01-line-016",
    "shot_id": "shot-e01-013",
    "planned_start_frame": 12,
    "planned_end_frame": 84,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "晚些你陪我一起练。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b028"
      ]
    },
    "id": "e01-line-017",
    "shot_id": "shot-e01-013",
    "planned_start_frame": 84,
    "planned_end_frame": 142,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "好啊。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b029"
      ]
    },
    "id": "e01-line-018",
    "shot_id": "shot-e01-013",
    "planned_start_frame": 142,
    "planned_end_frame": 156,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "你先把手给我看看。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s001",
      "block_ids": [
        "screenplay-04-lantern-home-s001-b031"
      ]
    },
    "id": "e01-line-019",
    "shot_id": "shot-e01-014",
    "planned_start_frame": 12,
    "planned_end_frame": 204,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "我娘一句一句哼的，抄了七个晚上呢。别叫你一把粘走了。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b003"
      ]
    },
    "id": "e01-line-020",
    "shot_id": "shot-e01-016",
    "planned_start_frame": 12,
    "planned_end_frame": 189,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "早干啦。你看——",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b004"
      ]
    },
    "id": "e01-line-021",
    "shot_id": "shot-e01-016",
    "planned_start_frame": 189,
    "planned_end_frame": 228,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "墨耳，过来。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b007"
      ]
    },
    "id": "e01-line-022",
    "shot_id": "shot-e01-018",
    "planned_start_frame": 12,
    "planned_end_frame": 108,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "真给墨耳留着了。我以为你半路就吃了。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b009"
      ]
    },
    "id": "e01-line-023",
    "shot_id": "shot-e01-019",
    "planned_start_frame": 12,
    "planned_end_frame": 140,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "我有那么馋——",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b010"
      ]
    },
    "id": "e01-line-024",
    "shot_id": "shot-e01-019",
    "planned_start_frame": 140,
    "planned_end_frame": 180,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "河街路人",
    "entity": {
      "object_id": "entity-street-passers",
      "revision_id": "5ab8b394cdb5fcc74c62ac1f74ac0f04ab1a1bf78e982d1e20317a6daa94437a"
    },
    "text": "赵执事",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b012"
      ]
    },
    "id": "e01-line-025",
    "shot_id": "shot-e01-020",
    "planned_start_frame": 12,
    "planned_end_frame": 132,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "赵执事",
    "entity": {
      "object_id": "entity-zhao",
      "revision_id": "df59d6eb8f8942301fc5ccaf44da0fe05a7ee9f89698d2d9fca77a4838dbbc75"
    },
    "text": "你娘的身体还没养好？",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b014"
      ]
    },
    "id": "e01-line-026",
    "shot_id": "shot-e01-021",
    "planned_start_frame": 12,
    "planned_end_frame": 102,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "还得养。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b015"
      ]
    },
    "id": "e01-line-027",
    "shot_id": "shot-e01-021",
    "planned_start_frame": 102,
    "planned_end_frame": 132,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "赵执事",
    "entity": {
      "object_id": "entity-zhao",
      "revision_id": "df59d6eb8f8942301fc5ccaf44da0fe05a7ee9f89698d2d9fca77a4838dbbc75"
    },
    "text": "庙里缺领唱的。迎蛇的调子，会不会？",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b016"
      ]
    },
    "id": "e01-line-028",
    "shot_id": "shot-e01-022",
    "planned_start_frame": 12,
    "planned_end_frame": 96,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "不会。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b017"
      ]
    },
    "id": "e01-line-029",
    "shot_id": "shot-e01-022",
    "planned_start_frame": 96,
    "planned_end_frame": 108,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "会前两段。要唱几天？",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b019"
      ]
    },
    "id": "e01-line-030",
    "shot_id": "shot-e01-023",
    "planned_start_frame": 12,
    "planned_end_frame": 132,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "赵执事",
    "entity": {
      "object_id": "entity-zhao",
      "revision_id": "df59d6eb8f8942301fc5ccaf44da0fe05a7ee9f89698d2d9fca77a4838dbbc75"
    },
    "text": "领唱的词在这儿。学会了来找我。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b021"
      ]
    },
    "id": "e01-line-031",
    "shot_id": "shot-e01-024",
    "planned_start_frame": 12,
    "planned_end_frame": 132,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "你真要去？陶伯家的阿禾姐姐，起先也是去唱歌。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b023"
      ]
    },
    "id": "e01-line-032",
    "shot_id": "shot-e01-026",
    "planned_start_frame": 12,
    "planned_end_frame": 132,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "她还教过我翻花绳。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b025"
      ]
    },
    "id": "e01-line-033",
    "shot_id": "shot-e01-028",
    "planned_start_frame": 12,
    "planned_end_frame": 84,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "前年阿禾，去年下湾的小满，送去祭蛇，都没回来。今年又要点名字了。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b026"
      ]
    },
    "id": "e01-line-034",
    "shot_id": "shot-e01-029",
    "planned_start_frame": 12,
    "planned_end_frame": 180,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "我也怕。得跟赵执事问清楚再唱。许家的活够吃几天，以后呢？",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b028"
      ]
    },
    "id": "e01-line-035",
    "shot_id": "shot-e01-030",
    "planned_start_frame": 12,
    "planned_end_frame": 252,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "李寄",
    "entity": {
      "object_id": "entity-li-ji",
      "revision_id": "28fdb4862c3820c89ef2a6eed1d9b36c9548a73055c894325180e07ad04d737f"
    },
    "text": "我家还有粮。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",
      "block_ids": [
        "screenplay-04-lantern-home-s002-b029"
      ]
    },
    "id": "e01-line-036",
    "shot_id": "shot-e01-031",
    "planned_start_frame": 12,
    "planned_end_frame": 49,
    "fps": 24,
    "timing_status": "镜内按字数暂分的排练窗口，非实测；实际录音与表演审阅后修订"
  },
  {
    "type": "dialogue",
    "speaker": "阿蘅",
    "entity": {
      "object_id": "entity-a-heng",
      "revision_id": "c431d8382100c6eb6b88e84ce092de3fd7074f554fe1c7f362dcb25a9a90fe2c"
    },
    "text": "上个月婶婶才给我们送过米。你家也不宽裕。",
    "source": {
      "object_id": "screenplay-04-lantern-home-e01",
      "revision_id": "8148732c492764da35ae228d6ba7613ae8108fb121aa30802088165721e3013e",
      "scene_id": "s002",

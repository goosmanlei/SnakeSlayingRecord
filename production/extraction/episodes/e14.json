  "decision": {
    "format_reviewed_roles": true,
    "assessment": "逐镜核对第14集S032/S033：保留蛇断口、父亲肩垫磨开及四项镜头自有卸力参考；把卸肩后持续压杠使用范围迁回前镜连续性。",
    "continuity": "断处错开与刀到底先于放刀；双手离柄先于力竭扶臂；余响终止及检查后同号慢卸；本集没有归家洗手换净布。原件、调用、旧方案和评论保持。",
    "names": {
      "form-snake-severed": "大蛇 · 断口错开",
      "material-form-officer-cheng-spent-overall": "命别开、去请石匠 · 程差役卸力扶石盖参考",
      "material-form-li-xiao-spent-overall": "孙六靠墙、姐姐掰指 · 李绡卸力表演参考",
      "material-form-sun-liu-spent-overall": "孙六靠墙、姐姐掰指 · 孙六卸力表演参考",
      "material-form-li-dan-sore-overall": "父亲无力抬臂、碰额接女儿 · 肩痛接触参考"
    },
    "state_dimensions": {
      "form-li-dan-pad-fallen": [
        "clothing",
        "fatigue"
      ]
    },
    "state_attributes": {
      "form-snake-severed": {
        "appearance": "同一条蛇的鳞纹与体量保持；仅从刀缝可见同一颈断处，不掀盖显示全身。头在南投食门内侧，余身留洞。",
        "injury": "颈断口两边错开，刀可触底石；不把静止、安全或开门许可当作断口图的视觉属性。"
      }
    },
    "append_conditions": {
      "entity-snake": "第14集断处错开后仍有洞内擦撞，确认断处并等待余响结束后才卸肩；声音条件会结束，不能据断口图提前宣布安全或开启南门。"
    },
    "released_states": {
      "av-e14-a03-s05": [
        "form-helpers-four-loaded",

  "decision": {
    "assessment": "第2集S003/S00422镜逐场重新抽取：保留卷幕/湿幕、纸蛇装配、两人必要湿区、歌本湿裂与暮夜光照等十个有真实自有需求的状态；湿浆沿新增普通实体，索浆、滑跪、失词停唱、粘米和账目沿镜头。没有新增空状态或需求。湿袖状态把真正湿区归入属性，李寄湿态删不变身份音色和病疲套话，职责命名统一。",
    "continuity": "抛书前完整干本夹旧纸；漂浮后提起才纸裂；阿蘅滑跪后湿袖与膝下，李寄卷裤下水后湿衣。两次船边停唱由角色表演，不能由完整歌填回缺词。退预付只一小把，唱工米仍在；开口与再系紧在准确镜头，不另保留退米空状态。",
    "format_reviewed_roles": true,
    "names": {
      "form-river-street-night": "河街 · 暮夜光照"
    },
    "state_dimensions": {
      "form-li-ji-wet": [
        "attachments",
        "clothing",
        "injury"
      ]
    },
    "state_attributes": {
      "form-a-heng-wet": {
        "clothing": "同一青衣与发式；滑跪捞书后两袖至肘、膝下和裙裤下摆明显湿深，贴腿处形成大块深青。湿袖在退米镜可粘少量米粒，未换衣前不恢复干色。",
        "injury": "脸与手没有新增伤口；湿衣与李寄后续掌额伤无关。"
      }
    },

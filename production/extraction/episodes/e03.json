  "decision": {
    "assessment": "第3集S005/S00619镜重抽取，保留七个有真实直接需求的状态：三种李寄掌伤/局部湿区、湿幕与三种歌本纸面组合。借据翻面压贴纸、钱币转交、谈判和记数动作进入镜头及既有工程。左掌沿已有制作选取，不宣称剧本给出左右。补晾布处和同一唱工纸的可读说明，不新增实体或需求。",
    "continuity": "上午木屑浅掌伤未包，午后才包，额角一直完整；十来天后挑水过浅滩仅裤脚溅湿，掌布衣摆干。残页晒干→新纸并置抄至五字留白→阿蘅夹入→十来天后才写两升。歌本背页与后续取出的工纸为同一张，后集实际天数另按准确字层。",
    "format_reviewed_roles": true,
    "state_dimensions": {
      "form-li-ji-abrasion": [
        "attachments",
        "clothing",
        "injury"
      ],
      "form-li-ji-wrapped": [
        "attachments",
        "clothing",
        "injury"
      ],
      "form-li-ji-splash": [
        "attachments",
        "clothing",
        "injury"
      ]
    },
    "edits": {
      "entity-drying-area": {
        "production_description": "道具屋外的晾布杆架，两端稳接临岸干地，留两人各撑布端与行走通路。与连续可涉浅滩、河对岸挑水位置保持同一拓扑；幕布在手、挂牢或拧水沿具体镜头，不把挂好结果固定到所有起点。"
      },
      "entity-work-ledger": {
        "production_description": "阿蘅用半截木炭在同一歌本背页记录唱工；S006先核约定两升，S007再逐日记两笔工钱。纸可夹存、取出、置桌和递交留证，保持同张炭迹、皱痕与缺口，不另外造账本或抄件；原纸交梁后没有归还记录，后发清账凭据为另一物。准确数字由既有字层工程表达。"
      }
    },
